# TripPilot AI Backend Configuration
PORT=8001
HOST=0.0.0.0
ENVIRONMENT=development

# ==========================================
# 1. Groq Cloud AI Configuration
# Get your free key at: https://console.groq.com/keys
# ==========================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# 2. Supabase Cloud Configuration
# Get your Project URL & Anon Key from:
# https://app.supabase.com -> Project -> Settings -> API
# ==========================================
SUPABASE_URL=
SUPABASE_KEY=

# Optional alternative LLM keys
OPENAI_API_KEY=
GEMINI_API_KEY=

# ==========================================
# 3. Razorpay Payment Gateway (Test Mode)
# Get your free test keys from:
# https://dashboard.razorpay.com/app/keys
# ==========================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ==========================================
# 4. Auth Security (JWT Secret)
# Generate a strong 256-bit secret key (e.g., openssl rand -hex 32)
# ==========================================
SECRET_KEY=
TOKEN_EXPIRE_DAYS=7

# ==========================================
# 5. Production CORS Configuration
# Set to your primary production frontend domain:
# e.g., FRONTEND_URL=https://trippilot.vercel.app
# Multiple origins can be separated by commas:
# e.g., FRONTEND_URL=https://trippilot.vercel.app,https://your-custom-domain.com
# ==========================================
FRONTEND_URL=
ADDITIONAL_CORS_ORIGINS=
